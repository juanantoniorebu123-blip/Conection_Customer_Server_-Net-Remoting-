<?xml version="1.0" encoding="utf-8" ?>
<configuration>




	<system.runtime.remoting>

		<application>

			<lifetime leaseTime="02:00:00"
					  renewOnCallTime="1h"
					  sponsorshipTimeout="2m"
					  leaseManagerPollTime="10s" />

		</application>

	</system.runtime.remoting>




	<startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>